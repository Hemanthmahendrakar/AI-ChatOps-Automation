pipeline {

    agent any

    options {
        disableConcurrentBuilds()
    }


    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

    }


    stages {


        stage('Checkout') {

            steps {

                git branch: 'main',
                    url: 'https://github.com/Hemanthmahendrakar/AI-ChatOps-Automation.git'

            }

        }



        stage('AWS Authentication') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds'
                    ]
                ]) {


                    sh '''

                    echo "Checking AWS credentials..."

                    aws configure set region $AWS_DEFAULT_REGION

                    aws sts get-caller-identity

                    '''

                }

            }

        }




        stage('Terraform Init') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds'
                    ]
                ]) {


                    sh '''

                    echo "Terraform Init"

                    cd terraform


                    terraform init -reconfigure


                    '''

                }

            }

        }





        stage('Terraform Plan') {

            steps {


                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds'
                    ]
                ]) {


                    sh '''

                    echo "Terraform Plan"


                    cd terraform


                    terraform plan


                    '''

                }

            }

        }






        stage('Terraform Apply') {


            steps {


                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds'
                    ]
                ]) {


                    sh '''

                    echo "Terraform Apply"


                    cd terraform


                    terraform apply -auto-approve


                    '''

                }

            }

        }







        stage('Get Terraform Outputs') {


            steps {


                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds'
                    ]
                ]) {


                    sh '''

                    echo "Reading Terraform outputs"


                    cd terraform



                    OPENWEBUI_IP=$(terraform output -raw openwebui_public_ip)

                    OLLAMA_IP=$(terraform output -raw ollama_public_ip)



                    echo "Open WebUI IP: $OPENWEBUI_IP"

                    echo "Ollama IP: $OLLAMA_IP"



                    cd ../ansible



                    sed -i "s/OPENWEBUI_IP/$OPENWEBUI_IP/g" inventory.ini

                    sed -i "s/OLLAMA_IP/$OLLAMA_IP/g" inventory.ini



                    echo "Updated Ansible Inventory"


                    cat inventory.ini


                    '''

                }

            }

        }







        stage('Ansible Deploy') {


            steps {


                sshagent(['ec2-key']) {


                    sh '''

                    echo "Running Ansible Deployment"


                    cd ansible



                    ansible-playbook \
                    -i inventory.ini \
                    playbook.yml



                    '''

                }

            }

        }



    }





    post {


        success {

            echo "================================="

            echo "Deployment completed successfully"

            echo "================================="

        }



        failure {

            echo "================================="

            echo "Deployment failed. Check logs"

            echo "================================="

        }


    }

}
