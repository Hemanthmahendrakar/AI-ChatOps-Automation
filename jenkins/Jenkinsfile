pipeline {

    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
    }


    stages {


        stage('Checkout') {

            steps {

                git branch: 'main',
                    url: 'https://github.com/Hemanthmahendrakar/AI-ChatOps-Automation.git'

            }

        }



        stage('AWS Authentication') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds'
                    ]
                ]) {


                    sh '''

                    echo "Checking AWS credentials"

                    aws configure set region $AWS_DEFAULT_REGION

                    aws sts get-caller-identity

                    '''

                }

            }

        }




        stage('Terraform Init') {

            steps {


                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds'
                    ]
                ]) {


                    sh '''

                    echo "Terraform Init"

                    cd terraform

                    terraform init -reconfigure

                    '''

                }

            }

        }




        stage('Terraform Plan') {

            steps {


                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds'
                    ]
                ]) {


                    sh '''

                    echo "Terraform Plan"

                    cd terraform

                    terraform plan -out=tfplan

                    '''

                }

            }

        }





        stage('Terraform Apply') {


            steps {


                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds'
                    ]
                ]) {


                    sh '''

                    echo "Terraform Apply"

                    cd terraform

                    terraform apply -auto-approve tfplan

                    '''

                }

            }

        }





        stage('Wait for Instance Boot') {


            steps {


                sh '''

                echo "Waiting 3 minutes for EC2 initialization..."

                sleep 180

                echo "Instance boot wait completed"

                '''

            }

        }







        stage('Generate Ansible Inventory') {


            steps {


                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-creds'
                    ]
                ]) {


                    sh '''

                    echo "Generating Ansible Inventory"



                    cd terraform



                    OPENWEBUI_IP=$(terraform output -raw openwebui_public_ip)

                    OLLAMA_IP=$(terraform output -raw ollama_public_ip)



                    echo "OpenWebUI IP: $OPENWEBUI_IP"

                    echo "Ollama IP: $OLLAMA_IP"




                    cd ../ansible




                    cat > inventory.ini <<EOF

[openwebui]

openwebui-server ansible_host=$OPENWEBUI_IP



[ollama]

ollama-server ansible_host=$OLLAMA_IP



[all:vars]

ansible_user=ubuntu

EOF




                    echo "Updated Inventory"

                    cat inventory.ini



                    '''

                }

            }

        }









        stage('Ansible Deploy') {


            steps {


                sshagent(['ec2-key']) {


                    sh '''

                    echo "Running Ansible"



                    cd ansible




                    ansible-playbook \
                    -i inventory.ini \
                    playbook.yml \
                    -e "ansible_ssh_common_args='-o StrictHostKeyChecking=no'"



                    '''

                }

            }

        }


    }





    post {


        success {


            echo """

            =================================

            Deployment completed successfully

            =================================

            """

        }




        failure {


            echo """

            =================================

            Deployment failed. Check logs

            =================================

            """

        }


    }

}
